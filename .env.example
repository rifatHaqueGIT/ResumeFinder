# Database (default: local SQLite for development)
# For AWS RDS PostgreSQL: postgresql://user:pass@host:5432/resume_intelligence
DATABASE_URL=sqlite:///./resume_intelligence.db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Resume scanning root
SCAN_ROOT=C:\Users\Rifat

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
